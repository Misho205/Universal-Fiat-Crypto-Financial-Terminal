# HybridPay Terminal — NEVER commit real secrets. Live mode is OFF.
LIVE_MODE=false
# --- Modal backend auth (server-side; browser holds only the sandbox bearer in memory) ---
API_SHARED_TOKEN=dev-shared-token
API_ADMIN_TOKEN=
# --- Durable data layer ---
# Local/dev default: ./data/hybridpay.db (auto-created, gitignored).
# Modal: Volume hybridpay-data at /mnt/data (auto-used) — set HYBRIDPAY_DB_PATH only to override.
HYBRIDPAY_DB_PATH=
# Production Postgres (Neon/Supabase/RDS). When set, it replaces SQLite entirely.
# Never commit real URLs; inject via Modal Secret hybridpay-test.
DATABASE_URL=
# Frontend (browser-safe, NEXT_PUBLIC_* only — never secrets/keys here):
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MODAL_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TOKEN=dev-shared-token
NEXT_PUBLIC_LIVE_MODE=false
DATABASE_URL=postgresql://hybridpay:hybridpay@localhost:5432/hybridpay
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
OPA_URL=http://localhost:8181
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
JWT_DEV_SECRET=dev-only-insecure-secret
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
BTCPAY_URL_TEST=http://localhost:23000
BTCPAY_API_KEY_TEST=
BTCPAY_STORE_ID_TEST=
SEPOLIA_RPC_URL=
EVM_CONFIRMATIONS_REQUIRED=2
PORT_API=3001
PORT_TERMINAL=3000
